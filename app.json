{
  "expo": {
    "name": "Runiczny Duch Klient",
    "slug": "runiczny-duch-klient",
    "scheme": "runicznyduchklient",
    "version": "3.3.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07111d",
    "android": {
      "package": "de.runicznyduch.client",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ],
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/ikona-klient.png",
    "extra": {
      "eas": {
        "projectId": "750c682c-4934-4765-a9f9-0fd61f629c97"
      }
    }
  }
}
